rules_version = '2';

// Firestore security rules.
//
// Firebase's 30-day test-mode rules have expired, revoking open access.
// These rules require authentication for all reads/writes. The app signs in
// anonymously at bootstrap (see lib/app.dart), so an authenticated session is
// always available to the Firestore/Storage demos without forcing the user
// through the Firebase Auth demo's login form.
//
// Deploy (requires user approval):
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
